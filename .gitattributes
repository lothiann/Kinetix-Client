# Normalize all text files to LF line endings (Kinetix standard)
* text=auto eol=lf

# Vendored / binary — never normalize
other/*/include/* linguist-vendored
src/engine/external/* linguist-vendored
vendor/** -text

# Common binary file types — mark as binary explicitly
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.icns binary
*.tga binary
*.webp binary
*.wav binary
*.ogg binary
